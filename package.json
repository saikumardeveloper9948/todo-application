{
  "name": "todo-application",
  "version": "1.0.0",
  "description": "MERN Stack To-Do Application",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm start --prefix frontend\"",
    "start": "concurrently \"npm start --prefix backend\" \"npm start --prefix frontend\"",
    "backend": "npm start --prefix backend",
    "frontend": "npm start --prefix frontend",
    "backend:dev": "npm run dev --prefix backend",
    "frontend:dev": "npm start --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}



